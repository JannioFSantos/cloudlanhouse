# ---------------------------------------------------------------------------
# xbox-play — copie para .env e ajuste
# ---------------------------------------------------------------------------

# Porta HTTP (o servidor escuta em 0.0.0.0)
PORT=8080

# URL pública do site (usada no QR Pix, links e webhook)
BASE_URL=http://localhost:8080

# Pasta de dados (sessões, pedidos, fila, segredos)
DATA_DIR=./data

# Segredo do PC que transmite (host.html). Se vazio, é gerado e impresso no boot.
HOST_KEY=

# Senha do painel /admin. Se vazio, é gerada e impressa no boot.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Pagamento
#   mercadopago -> Pix real
#   mock        -> botão "simular pagamento" (teste local)
# Se MP_ACCESS_TOKEN estiver vazio, cai automaticamente em mock.
# ---------------------------------------------------------------------------
PAYMENT_MODE=mock
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=

# ---------------------------------------------------------------------------
# Regras de negócio (padrões já são os combinados)
# ---------------------------------------------------------------------------
MAX_HOURS=4
PAYMENT_TTL_SEC=900
PROVISION_TIMEOUT_SEC=180
QUEUE_HOLD_SEC=300

# Comandos opcionais para ligar/desligar o Xbox (rodados no PC host).
# Ex.: scripts/wake-xbox.ps1  |  scripts/xbox-off.ps1
XBOX_POWER_ON_CMD=
XBOX_POWER_OFF_CMD=

# ---------------------------------------------------------------------------
# Ponte de controle (tools/gamepad-bridge) — roda no PC host, Windows
# Se o servidor estiver em outra máquina/VPS, aponte para ele e informe a
# mesma HOST_KEY acima. Na mesma máquina, nada disso é necessário.
# ---------------------------------------------------------------------------
# BRIDGE_URL=wss://seu-dominio.com/ws
# BRIDGE_PYTHON=python
# BRIDGE_DRY_RUN=0

# ---------------------------------------------------------------------------
# Rede
# STUN público + TURN opcional (obrigatório se o PC estiver atrás de CGNAT)
# ---------------------------------------------------------------------------
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Confie em X-Forwarded-For (coloque 1 atrás de Caddy/Nginx/Cloudflare)
TRUST_PROXY=0

# Log verboso
DEBUG=0
